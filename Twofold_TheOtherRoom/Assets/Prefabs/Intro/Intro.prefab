--- !u!114 &3197716020936433381
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4286918676697841504}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8f24f64d3812014b947fcc0cf1a4d2b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroNarration
  source: {fileID: 4503442637563984723}
  clip: {fileID: 8300000, guid: db9637d0a1850ff4cae3d402d031fb66, type: 3}
  subtitle: {fileID: 1416552488243826835}
  lines:
  - start: 0
    text: "Twofold\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4."
  - start: 2.9
    text: "\uB450 \uC0AC\uB78C\uC740 \uC11C\uB85C \uB2E4\uB978 \uCC28\uC6D0\uC5D0\uC11C
      \uAC8C\uC784\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - start: 6.7
    text: "2D\uC5D0\uC11C\uB294 \uB9C8\uC6B0\uC2A4\uB85C \uC870\uC791\uD558\uACE0,"
  - start: 9.2
    text: "3D\uC5D0\uC11C\uB294 WASD\uB85C \uC774\uB3D9\uD558\uBA70 E\uD0A4 \uB610\uB294
      \uB9C8\uC6B0\uC2A4\uB85C \uC0C1\uD638\uC791\uC6A9\uD569\uB2C8\uB2E4."
  - start: 16.1
    text: "\uAC01 \uCC28\uC6D0\uC758 \uD37C\uC990\uC744 \uD480\uACE0, \uC228\uACA8\uC9C4
      \uAC70\uC6B8 \uC870\uAC01\uC744 \uCC3E\uC544 \uAC01\uC790\uC758 \uAC70\uC6B8\uC744
      \uC644\uC131\uD574\uC57C \uD569\uB2C8\uB2E4."
  - start: 22.7
    text: "\uD37C\uC990\uC740 \uCD1D 10\uAC1C. \uAC01 \uCC28\uC6D0\uC5D0\uB294 5\uAC1C\uC758
      \uAC70\uC6B8 \uC870\uAC01\uC774 \uC874\uC7AC\uD569\uB2C8\uB2E4."
  - start: 28.6
    text: "\uC81C\uD55C \uC2DC\uAC04\uC740 15\uBD84\uC785\uB2C8\uB2E4."
  - start: 31.3
    text: "\uB450 \uCC28\uC6D0\uC758 \uD611\uB825\uB9CC\uC774 \uC774\uACF3\uC744
      \uD0C8\uCD9C\uD560 \uC218 \uC788\uB294 \uC720\uC77C\uD55C \uBC29\uBC95\uC785\uB2C8\uB2E4."
